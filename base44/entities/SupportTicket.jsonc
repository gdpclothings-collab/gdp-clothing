{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "customerEmail": {
      "type": "string"
    },
    "customerName": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    }
  },
  "required": [
    "subject",
    "message",
    "customerEmail"
  ]
}